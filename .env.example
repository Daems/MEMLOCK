# Kie.ai API credentials
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

# Optional callback URL. Leave empty to use polling.
KIE_CALLBACK_URL=

# Local storage
NB_OUTPUT_DIR=outputs
NB_DB_PATH=outputs/tasks.sqlite3

# Defaults
NB_DEFAULT_ASPECT_RATIO=1:1
NB_DEFAULT_RESOLUTION=1K
NB_DEFAULT_OUTPUT_FORMAT=png
